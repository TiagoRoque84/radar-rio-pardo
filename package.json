{
  "name": "radar-rio-pardo",
  "version": "1.0.0",
  "private": true,
  "description": "Portal independente de informação pública, transparência municipal e jornalismo de dados de São José do Rio Pardo - SP.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && tsx scripts/init-db-if-needed.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:use-mysql": "node scripts/switch-db-provider.mjs mysql",
    "db:use-sqlite": "node scripts/switch-db-provider.mjs sqlite",
    "collect:cron": "tsx scripts/run-collectors.ts",
    "auth:reset-password": "tsx scripts/reset-user-password.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "lucide-react": "^0.475.0",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.4",
    "postcss": "^8.5.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
