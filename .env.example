# ==============================================================================
# RADAR RIO PARDO — VARIÁVEIS DE AMBIENTE (EXEMPLO)
# Copie este arquivo para `.env` localmente ou configure no painel da Hostinger.
# NUNCA versione credenciais reais no Git.
# ==============================================================================

# Ambiente de execução (development | production | test)
NODE_ENV="development"

# URL pública principal do portal
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Radar Rio Pardo"
NEXT_PUBLIC_MUNICIPALITY="São José do Rio Pardo - SP"

# ------------------------------------------------------------------------------
# BANCO DE DADOS
# Local (desenvolvimento rápido com SQLite):
DATABASE_URL="file:./dev.db"
#
# Produção (Hostinger Cloud Startup - MySQL):
# DATABASE_URL="mysql://USUARIO_MYSQL:SENHA_FORTE@localhost:3306/NOME_DO_BANCO"
# ------------------------------------------------------------------------------

# Segredo criptográfico para assinatura de sessões JWT/HMAC (mínimo 32 caracteres)
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="substitua-por-uma-chave-secreta-aleatoria-com-mais-de-32-caracteres"

# Segredo para proteger o endpoint de Cron Job da Hostinger (/api/cron/collect)
CRON_SECRET="substitua-por-um-token-aleatorio-para-cron-job"

# ------------------------------------------------------------------------------
# CREDENCIAIS INICIAIS PARA SEED DE DESENVOLVIMENTO (OPCIONAL)
# Altere imediatamente após o primeiro acesso em produção.
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@radarriopardo.com.br"
SEED_ADMIN_PASSWORD="TroqueEstaSenhaNoPrimeiroAcesso!2026"

# ------------------------------------------------------------------------------
# INTELIGÊNCIA ARTIFICIAL OPCIONAL (FASE 2 — O MVP FUNCIONA SEM CHAVE DE IA)
# ------------------------------------------------------------------------------
AI_PROVIDER="disabled"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_MONTHLY_BUDGET_BRL="50.00"

# ------------------------------------------------------------------------------
# ANALYTICS OPCIONAL (SEM DADOS PESSOAIS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_ID=""
